{
  "name": "blackpool-core-evm",
  "version": "1.0.0",
  "description": "Pay anyone. Show no one. Zero-knowledge privacy pools on four chains, no custody, relayer pays the gas.",
  "main": "src/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "compile:hasher": "node scripts/compileHasher.js",
    "compile": "hardhat build && node scripts/compileHasher.js",
    "build": "npm run circuit && npm run compile",
    "test": "hardhat test mocha",
    "prettier:check": "prettier --check . --config .prettierrc",
    "prettier:fix": "prettier --write . --config .prettierrc",
    "zk:parity": "node scripts/zkParity.js",
    "validate:upgrades": "openzeppelin-upgrades-core validate artifacts/build-info --unsafeAllow state-variable-immutable,constructor --exclude 'contracts/Mocks/**'"
  },
  "keywords": [],
  "author": "Blackpool <dev@blackpool.cash>",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "ethers5": "npm:ethers@5.8.0",
    "express": "^5.3.0",
    "ffjavascript": "^0.2.36",
    "fixed-merkle-tree": "^0.7.3",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.5",
    "tmp-promise": "^3.0.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@openzeppelin/upgrades-core": "^1.47.0",
    "bignumber.js": "^9.0.0",
    "chai": "^5.2.0",
    "circomlibjs": "^0.1.7",
    "dotenv": "^10.0.0",
    "ethers": "^6.15.0",
    "hardhat": "^3.21.2",
    "mocha": "^12.0.0",
    "prettier": "^2.3.1",
    "prettier-plugin-solidity": "^1.0.0-beta.13",
    "prompt-sync": "^4.2.0",
    "solhint-plugin-prettier": "^0.0.5"
  },
  "type": "module",
  "overrides": {
    "ws": "^8.21.0",
    "underscore": "^1.13.8",
